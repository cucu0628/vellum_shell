#!/usr/bin/env bash
# Az elo Hyprland monitorelrendezesbol general egy X11 Xsetup scriptet az SDDM-nek.
# Az SDDM sajat X szervert indit, ami nem ismeri a compositor elrendezeset: enelkul
# a kijelzok sorrendje/pozicioja mas lehet, mint a munkamenetben.
#
# FONTOS: a greeter X szervere MAS connector-neveket ad, mint a Wayland
# munkamenet (amdgpu alatt pl. HDMI-A-1 helyett HDMI-A-0, DP-2 helyett
# DisplayPort-1, meg az indexeles is eltolodik). Ezert a generalt Xsetup nem
# neveket eget be, hanem futasidoben, az EDID alapjan keresi meg a megfelelo
# kimenetet. Ha az EDID nem elerheto, visszaesik a Wayland nevre.
#
# Elsodleges kijelzo: a `lockscreen-monitor`, kulonben a fokuszalt, kulonben az elso.
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
[[ -d $base ]] || base="$(cd "$(dirname "$0")/.." && pwd)"

output=${1:-"$base/sddm/vellum-ink/Xsetup"}

command -v hyprctl >/dev/null 2>&1 || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

monitors=$(hyprctl monitors -j 2>/dev/null) || exit 0
[[ -n $monitors && $monitors != "[]" ]] || exit 0

preferred=""
[[ -r "$base/lockscreen-monitor" ]] && preferred=$(<"$base/lockscreen-monitor")
preferred=${preferred//[[:space:]]/}

# name<TAB>WxH<TAB>XxY<TAB>edid-kulcs<TAB>primary(0|1)
rows=$(python3 - "$preferred" "$monitors" <<'PY'
import glob, json, sys

preferred = sys.argv[1]
monitors = json.loads(sys.argv[2])
if not monitors:
    raise SystemExit

names = [m["name"] for m in monitors]
if preferred not in names:
    focused = [m["name"] for m in monitors if m.get("focused")]
    preferred = focused[0] if focused else names[0]

def edid_key(connector):
    """A kijelzo EDID leiroibol a legjobb azonosito: sorozatszam, kulonben nev.

    A sysfs binaris attributumok 0 meretet jelentenek, de olvashatoak."""
    paths = glob.glob(f"/sys/class/drm/card*-{connector}/edid")
    if not paths:
        return ""
    try:
        data = open(paths[0], "rb").read()
    except OSError:
        return ""
    if len(data) < 128:
        return ""
    serial = name = ""
    for i in range(54, 126, 18):
        block = data[i:i + 18]
        if block[0:3] != b"\x00\x00\x00":
            continue
        text = block[5:18].split(b"\n")[0].decode("ascii", "ignore").strip()
        if block[3] == 0xFF:
            serial = text
        elif block[3] == 0xFC:
            name = text
    return serial or name

for m in monitors:
    print("\t".join([
        m["name"],
        f'{m["width"]}x{m["height"]}',
        f'{m["x"]}x{m["y"]}',
        edid_key(m["name"]),
        "1" if m["name"] == preferred else "0",
    ]))
PY
) || exit 0
[[ -n $rows ]] || exit 0

mkdir -p "$(dirname "$output")"
tmp=$(mktemp "$(dirname "$output")/.Xsetup.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
  cat <<'HEADER'
#!/bin/sh
# Generated by the Vellum Shell backend tooling – ne szerkeszd kezzel.
#
# A greeter X szervere mas connector-neveket hasznal, mint a Wayland
# munkamenet, ezert minden kijelzot az EDID-je alapjan keresunk meg.

# Kiirja annak az xrandr kimenetnek a nevet, amelyik EDID-je tartalmazza a
# keresett szoveget. Ures, ha nincs talalat vagy nincs EDID.
resolve_output() {
    [ -n "$1" ] || return 0
    xrandr --verbose 2>/dev/null | awk -v want="$1" '
        function decode(hex,   i, n, out, hi, lo, c) {
            out = ""; n = length(hex)
            for (i = 1; i < n; i += 2) {
                hi = index("0123456789abcdef", tolower(substr(hex, i, 1))) - 1
                lo = index("0123456789abcdef", tolower(substr(hex, i + 1, 1))) - 1
                if (hi < 0 || lo < 0) continue
                c = hi * 16 + lo
                out = out ((c >= 32 && c < 127) ? sprintf("%c", c) : " ")
            }
            return out
        }
        function flush(   text) {
            if (name == "" || hex == "") return
            text = decode(hex)
            if (index(text, want) > 0) { print name; found = 1; exit }
        }
        /^[^ \t]/ { flush(); name = $1; hex = ""; grab = 0; next }
        /EDID:/   { grab = 1; next }
        grab && $0 ~ /^[ \t]*[0-9a-fA-F]+[ \t]*$/ { gsub(/[ \t]/, "", $0); hex = hex $0; next }
        grab      { grab = 0 }
        END { if (!found) flush() }
    '
}

# $1 = EDID kulcs, $2 = Wayland nev (tartalek), $3 = mod, $4 = pozicio, $5 = primary
place() {
    target=$(resolve_output "$1")
    [ -n "$target" ] || target="$2"
    if [ "$5" = 1 ]; then
        xrandr --output "$target" --mode "$3" --pos "$4" --rotate normal --primary 2>/dev/null || true
    else
        xrandr --output "$target" --mode "$3" --pos "$4" --rotate normal 2>/dev/null || true
    fi
}

HEADER
  while IFS=$'\t' read -r name mode pos key primary; do
    [[ -n $name ]] || continue
    printf "place '%s' '%s' '%s' '%s' %s\n" "$key" "$name" "$mode" "$pos" "$primary"
  done <<< "$rows"
} > "$tmp"

if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
  mv "$tmp" "$output"
fi
chmod 755 "$output"
printf '%s\n' "$output"
