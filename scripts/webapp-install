#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

name=${1:-$(prompt "Web app name")}
url=${2:-$(prompt "Web app URL")}
icon=${3:-$(prompt "Icon name" "web-browser")}
[[ -n $name && -n $url ]] || die "name and URL are required"
[[ $url == http://* || $url == https://* ]] || die "URL must start with http:// or https://"
[[ ! $url =~ [[:space:][:cntrl:]] ]] || die "URL must not contain whitespace or control characters"

id=$(desktop_safe_id "$name")
dir="$HOME/.local/share/applications/vellum-webapps"
mkdir -p "$dir"
desktop="$dir/vellum-webapp-$id.desktop"

cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$(desktop_string "$name")
Comment=Web app
Exec=xdg-open $(desktop_exec_arg "$url")
Icon=$(desktop_string "$icon")
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
EOF

update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
printf 'Installed web app: %s\n%s\n' "$name" "$desktop"
pause
