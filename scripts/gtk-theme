#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
source_file=${1:-}
output="$base/gtk-theme.css"

if [[ ! -r $source_file ]]; then
  current=""
  [[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
  source_file="$base/themes/$current/theme.conf"
fi

[[ -r $source_file ]] || exit 0

background="#1e1e2e"
foreground="#cdd6f4"
accent="#89b4fa"
surface="#181825"
muted="#9399b2"
selection=""
dark_background=""
lighter_background=""
red=""

while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value//[[:space:]\"]/}
  case "$key" in
    BACKGROUND) background=$value ;;
    FOREGROUND) foreground=$value ;;
    ACCENT|BORDER_FOREGROUND) accent=$value ;;
    SURFACE) surface=$value ;;
    MUTED) muted=$value ;;
    SELECTION) selection=$value ;;
    DARK_BACKGROUND) dark_background=$value ;;
    LIGHTER_BACKGROUND) lighter_background=$value ;;
    RED) red=$value ;;
  esac
done < "$source_file"

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#1e1e2e"
valid_color "$foreground" || foreground="#cdd6f4"
valid_color "$accent" || accent="#89b4fa"
valid_color "$surface" || surface="#181825"
valid_color "$muted" || muted="#9399b2"

mix() {
  local first=${1#\#} second=${2#\#} weight=$3 channel a b mixed result=""
  for channel in 0 2 4; do
    a=$((16#${first:channel:2}))
    b=$((16#${second:channel:2}))
    mixed=$(((a * weight + b * (100 - weight)) / 100))
    printf -v result '%s%02x' "$result" "$mixed"
  done
  printf '#%s' "$result"
}

valid_color "$selection" || selection="$accent"
valid_color "$dark_background" || dark_background="$background"
valid_color "$lighter_background" || lighter_background="$surface"
valid_color "$red" || red="#ff5449"

error_background=$(mix "$red" "$foreground" 55)
error_foreground=$(mix "#690005" "$background" 70)
accent_hex=${accent#\#}
accent_r=$((16#${accent_hex:0:2}))
accent_g=$((16#${accent_hex:2:2}))
accent_b=$((16#${accent_hex:4:2}))
accent_brightness=$(((accent_r * 299 + accent_g * 587 + accent_b * 114) / 1000))
if ((accent_brightness >= 145)); then
  accent_foreground=$background
else
  accent_foreground=$foreground
fi

tmp=$(mktemp "$base/.gtk-theme.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
  printf '/* Generated by vellum_shell. Import this file from GTK 3/4 gtk.css. */\n'
  printf '/* Destructive colors retain a red hue while following the active palette. */\n'
  printf '@define-color destructive_bg_color %s;\n' "$error_background"
  printf '@define-color destructive_fg_color %s;\n' "$error_foreground"
  printf '@define-color error_bg_color %s;\n' "$error_background"
  printf '@define-color error_fg_color %s;\n' "$error_foreground"
  printf '@define-color accent_fg_color %s;\n' "$accent_foreground"
  printf '@define-color accent_bg_color %s;\n' "$accent"
  printf '@define-color window_bg_color %s;\n' "$background"
  printf '@define-color window_fg_color %s;\n' "$foreground"
  printf '@define-color view_bg_color %s;\n' "$dark_background"
  printf '@define-color view_fg_color %s;\n' "$foreground"
  printf '@define-color headerbar_bg_color %s;\n' "$background"
  printf '@define-color headerbar_fg_color %s;\n' "$foreground"
  printf '@define-color sidebar_bg_color %s;\n' "$lighter_background"
  printf '@define-color sidebar_fg_color %s;\n' "$foreground"
  printf '@define-color secondary_sidebar_bg_color %s;\n' "$background"
  printf '@define-color secondary_sidebar_fg_color %s;\n' "$foreground"
  printf '@define-color card_bg_color %s;\n' "$lighter_background"
  printf '@define-color card_fg_color %s;\n' "$foreground"
  printf '@define-color overview_bg_color %s;\n' "$surface"
  printf '@define-color overview_fg_color %s;\n' "$foreground"
  printf '@define-color popover_bg_color %s;\n' "$lighter_background"
  printf '@define-color popover_fg_color %s;\n' "$foreground"
  printf '@define-color dialog_bg_color %s;\n' "$background"
  printf '@define-color dialog_fg_color %s;\n' "$foreground"
  printf '@define-color borders %s;\n' "$muted"
  printf '@define-color theme_selected_bg_color %s;\n' "$selection"
  printf '@define-color theme_selected_fg_color %s;\n' "$foreground"
  printf '\n/* Backdrop/unfocused states. */\n'
  printf '@define-color headerbar_backdrop_color @window_bg_color;\n'
  printf '@define-color sidebar_backdrop_color @sidebar_bg_color;\n'
  printf '@define-color theme_unfocused_fg_color @window_fg_color;\n'
  printf '@define-color theme_unfocused_text_color @view_fg_color;\n'
  printf '@define-color theme_unfocused_bg_color @window_bg_color;\n'
  printf '@define-color theme_unfocused_base_color @window_bg_color;\n'
  printf '@define-color theme_unfocused_selected_bg_color @accent_bg_color;\n'
  printf '@define-color theme_unfocused_selected_fg_color @accent_fg_color;\n'
} > "$tmp"

if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
  mv "$tmp" "$output"
fi

if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'
fi

systemctl --user restart xdg-desktop-portal-gtk.service xdg-desktop-portal.service >/dev/null 2>&1 || true
