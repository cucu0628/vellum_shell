#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

name=${1:-$(prompt "TUI launcher name")}
command_line=${2:-$(prompt "Command")}
icon=${3:-$(prompt "Icon name" "utilities-terminal")}
[[ -n $name && -n $command_line ]] || die "name and command are required"
[[ $command_line != *$'\n'* && $command_line != *$'\r'* ]] || die "command must be a single line"
command_name=${command_line%% *}
has "$command_name" || die "command not found: $command_name"

id=$(desktop_safe_id "$name")
dir="$HOME/.local/share/applications/vellum-tui"
mkdir -p "$dir"
desktop="$dir/vellum-tui-$id.desktop"

cat > "$desktop" <<EOF
[Desktop Entry]
Type=Application
Name=$(desktop_string "$name")
Comment=Terminal app
Exec=kitty -e $command_line
Icon=$(desktop_string "$icon")
Terminal=false
Categories=System;Utility;TerminalEmulator;
StartupNotify=false
EOF

update-desktop-database "$HOME/.local/share/applications" >/dev/null 2>&1 || true
printf 'Installed TUI launcher: %s\n%s\n' "$name" "$desktop"
pause
