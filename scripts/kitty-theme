#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
source_file=${1:-}
output="$base/kitty-theme.conf"

if [[ ! -r $source_file ]]; then
  current=""
  [[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
  source_file="$base/themes/$current/theme.conf"
fi

[[ -r $source_file ]] || exit 0

background="#1e1e2e"
foreground="#cdd6f4"
accent="#89b4fa"
surface="#181825"
muted="#9399b2"
selection=""
dark_background=""
dark_foreground=""
bright_foreground=""
red=""
yellow=""
green=""
cyan=""
blue=""
magenta=""
bright_red=""
bright_yellow=""
bright_green=""
bright_cyan=""
bright_blue=""
bright_magenta=""

while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value//[[:space:]\"]/}
  case "$key" in
    BACKGROUND) background=$value ;;
    FOREGROUND) foreground=$value ;;
    ACCENT|BORDER_FOREGROUND) accent=$value ;;
    SURFACE) surface=$value ;;
    MUTED) muted=$value ;;
    SELECTION) selection=$value ;;
    DARK_BACKGROUND) dark_background=$value ;;
    DARK_FOREGROUND) dark_foreground=$value ;;
    BRIGHT_FOREGROUND) bright_foreground=$value ;;
    RED) red=$value ;;
    YELLOW) yellow=$value ;;
    GREEN) green=$value ;;
    CYAN) cyan=$value ;;
    BLUE) blue=$value ;;
    MAGENTA) magenta=$value ;;
    BRIGHT_RED) bright_red=$value ;;
    BRIGHT_YELLOW) bright_yellow=$value ;;
    BRIGHT_GREEN) bright_green=$value ;;
    BRIGHT_CYAN) bright_cyan=$value ;;
    BRIGHT_BLUE) bright_blue=$value ;;
    BRIGHT_MAGENTA) bright_magenta=$value ;;
  esac
done < "$source_file"

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#1e1e2e"
valid_color "$foreground" || foreground="#cdd6f4"
valid_color "$accent" || accent="#89b4fa"
valid_color "$surface" || surface="#181825"
valid_color "$muted" || muted="#9399b2"

mix() {
  local first=${1#\#} second=${2#\#} weight=$3 channel a b mixed result=""
  for channel in 0 2 4; do
    a=$((16#${first:channel:2}))
    b=$((16#${second:channel:2}))
    mixed=$(((a * weight + b * (100 - weight)) / 100))
    printf -v result '%s%02x' "$result" "$mixed"
  done
  printf '#%s' "$result"
}

valid_color "$selection" || selection="$accent"
valid_color "$dark_background" || dark_background=$(mix "$surface" "$background" 70)
valid_color "$dark_foreground" || dark_foreground="$muted"
valid_color "$bright_foreground" || bright_foreground="$foreground"
valid_color "$red" || red="#f7768e"
valid_color "$green" || green="#9ece6a"
valid_color "$yellow" || yellow="#e0af68"
valid_color "$blue" || blue="$accent"
valid_color "$magenta" || magenta="#bb9af7"
valid_color "$cyan" || cyan="#7dcfff"
valid_color "$bright_red" || bright_red="#ff8fa3"
valid_color "$bright_green" || bright_green="#b9e87f"
valid_color "$bright_yellow" || bright_yellow="#f4c97a"
valid_color "$bright_blue" || bright_blue="#9bb8ff"
valid_color "$bright_magenta" || bright_magenta="#d0afff"
valid_color "$bright_cyan" || bright_cyan="#9de4ff"
tmp=$(mktemp "$base/.kitty-theme.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
  printf '# Generated by vellum_shell. Import this file from kitty.conf.\n'
  printf 'background %s\n' "$background"
  printf 'foreground %s\n' "$foreground"
  printf 'cursor %s\n' "$accent"
  printf 'cursor_text_color %s\n' "$background"
  printf 'selection_background %s\n' "$selection"
  printf 'selection_foreground %s\n' "$bright_foreground"
  printf 'url_color %s\n' "$accent"
  printf 'active_border_color %s\n' "$accent"
  printf 'inactive_border_color %s\n' "$muted"
  printf 'bell_border_color %s\n' "$accent"
  printf 'tab_bar_background %s\n' "$background"
  printf 'active_tab_background %s\n' "$accent"
  printf 'active_tab_foreground %s\n' "$background"
  printf 'inactive_tab_background %s\n' "$surface"
  printf 'inactive_tab_foreground %s\n' "$foreground"
  printf 'color0 %s\n' "$dark_background"
  printf 'color1 %s\n' "$red"
  printf 'color2 %s\n' "$green"
  printf 'color3 %s\n' "$yellow"
  printf 'color4 %s\n' "$blue"
  printf 'color5 %s\n' "$magenta"
  printf 'color6 %s\n' "$cyan"
  printf 'color7 %s\n' "$foreground"
  printf 'color8 %s\n' "$dark_foreground"
  printf 'color9 %s\n' "$bright_red"
  printf 'color10 %s\n' "$bright_green"
  printf 'color11 %s\n' "$bright_yellow"
  printf 'color12 %s\n' "$bright_blue"
  printf 'color13 %s\n' "$bright_magenta"
  printf 'color14 %s\n' "$bright_cyan"
  printf 'color15 %s\n' "$bright_foreground"
} > "$tmp"

if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
  mv "$tmp" "$output"
fi
