#!/usr/bin/env bash
# A Vellum Shell eltavolitasa.
#
#   scripts/uninstall [--dry-run] [--with-sddm] [--purge-state]
#
# Amit a setup.sh telepitett, azt visszabontja: a symlinket, a backendet, a
# generalt fajlokat es a sajat konfigokba beirt sorokat. A felhasznalo adataihoz
# (hatterkepek, kepernyokepek, a repo maga) nem nyul.
#
# Ez a script a telepites tulajdon-jegyzeke is: ami itt szerepel, azt hoztuk
# letre; ami nem, az a felhasznaloe volt mar elotte.
set -euo pipefail

dry_run=false
with_sddm=false
purge_state=false

usage() {
  cat <<'EOF'
Hasznalat: scripts/uninstall [opciok]

  --dry-run       Csak mutassa, mit torolne.
  --with-sddm     Tavolitsa el a Vellum Ink SDDM temat is (sudo kell hozza).
  --purge-state   Torolje a shell allapotat is (vagolap-elozmeny, gyorsitotar).
  -h, --help      Mutassa ezt a sugot.
EOF
}

while (( $# > 0 )); do
  case "$1" in
    --dry-run) dry_run=true ;;
    --with-sddm) with_sddm=true ;;
    --purge-state) purge_state=true ;;
    -h|--help) usage; exit 0 ;;
    *) printf 'Ismeretlen opcio: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if (( EUID == 0 )); then
  printf 'Hiba: ne futtasd sudo-val; a script szukseg eseten maga ker jogosultsagot.\n' >&2
  exit 1
fi

repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
target_dir="$HOME/.config/quickshell/vellum_shell"

act() {
  if [[ $dry_run == true ]]; then
    printf '  [terv] %s\n' "$*"
    return 0
  fi
  printf '  %s\n' "$*"
  "$@"
}

note() {
  printf '  %s\n' "$*"
}

# Egy szoveg literalis illesztese ERE-ben. A `/` szandekosan nincs benne: nem
# ERE metakarakter, es a `\/` a GNU grepet figyelmeztetesre birja.
ere_escape() {
  printf '%s' "$1" | sed 's/[][\.*^$(){}?+|]/\\&/g'
}

# Egy sor (es a hozza tartozo megjegyzes) kivetele egy felhasznaloi configbol.
# A fajl tobbi tartalmahoz nem nyulunk.
drop_lines() {
  local file=$1 pattern=$2
  [[ -r $file ]] || return 0
  grep -Eq "$pattern" "$file" || return 0

  if [[ $dry_run == true ]]; then
    printf '  [terv] sor(ok) kivetele innen: %s\n' "$file"
    grep -En "$pattern" "$file" | sed 's/^/      /'
    return 0
  fi

  local tmp
  tmp=$(mktemp)
  grep -Ev "$pattern" "$file" > "$tmp"
  install -m 644 "$tmp" "$file"
  rm -f "$tmp"
  printf '  sor(ok) kivetele innen: %s\n' "$file"
}

printf 'Backend leallitasa\n'
if systemctl --user is-enabled --quiet vellum-shelld.service 2>/dev/null; then
  act systemctl --user disable --now vellum-shelld.service
else
  note "a vellum-shelld.service nem volt engedelyezve"
fi
# Nem `[[ ... ]] && cmd` egysoros: `set -e` alatt a hamis teszt maga allitana
# meg a scriptet, mielott a tobbi lepes lefutna.
if [[ -e "$HOME/.config/systemd/user/vellum-shelld.service" ]]; then
  act rm -f "$HOME/.config/systemd/user/vellum-shelld.service"
fi
if [[ -e "$HOME/.local/bin/vellum" ]]; then
  act rm -f "$HOME/.local/bin/vellum"
fi
if [[ $dry_run == false ]]; then
  systemctl --user daemon-reload
fi

printf '\nHyprland modulok\n'
for module in vellum_display vellum_tuning colors; do
  file="$HOME/.config/hypr/$module.lua"
  # Csak a sajat generalt fajlokat toroljuk: a fejlec bizonyitja, hogy mienk.
  if [[ -e $file ]] && head -n1 "$file" | grep -Fq 'Generated by vellum_shell'; then
    act rm -f "$file"
  elif [[ -e $file ]]; then
    note "megorizve (nem a mienk): $file"
  fi
done

for module in bindings autostart; do
  file="$HOME/.config/hypr/$module.lua"
  if [[ -e $file ]] && cmp -s "$repo/hypr/$module.lua" "$file"; then
    act rm -f "$file"
  elif [[ -e $file ]]; then
    note "megorizve (sajat valtozat): $file"
  fi
done

drop_lines "$HOME/.config/hypr/hyprland.lua" \
  '^[[:space:]]*(--[[:space:]]*Vellum Shell modules|require\("(colors|bindings|autostart|vellum_display|vellum_tuning)"\))[[:space:]]*$'

printf '\nAlkalmazas-integraciok\n'
target_ere=$(ere_escape "$target_dir")
drop_lines "$HOME/.config/kitty/kitty.conf" \
  "^([[:space:]]*#[[:space:]]*Vellum Shell theme|include $target_ere/kitty-theme\.conf)[[:space:]]*$"
for gtk_version in 3.0 4.0; do
  drop_lines "$HOME/.config/gtk-$gtk_version/gtk.css" \
    "^(/\* Vellum Shell theme \*/|@import url\(\"$target_ere/gtk-theme\.css\"\);)[[:space:]]*$"
done
drop_lines "$HOME/.config/btop/btop.conf" '^[[:space:]]*color_theme[[:space:]]*=[[:space:]]*"vellum"[[:space:]]*$'
if [[ -e "$HOME/.config/btop/themes/vellum.theme" ]]; then
  act rm -f "$HOME/.config/btop/themes/vellum.theme"
fi

nvim_colors="$HOME/.local/share/nvim/site/colors/vellum.lua"
# A fejlec bizonyitja, hogy a generalt fajlt toroljuk, nem egy sajat temat.
if [[ -e $nvim_colors ]] && head -n1 "$nvim_colors" | grep -Fq 'Vellum Shell colorscheme'; then
  act rm -f "$nvim_colors"
fi
for nvim_module in vellum.lua vellum-keys.lua; do
  nvim_spec="$HOME/.config/nvim/lua/plugins/$nvim_module"
  if [[ -e $nvim_spec ]] && cmp -s "$repo/nvim/$nvim_module" "$nvim_spec"; then
    act rm -f "$nvim_spec"
  elif [[ -e $nvim_spec ]]; then
    note "megorizve (sajat valtozat): $nvim_spec"
  fi
done

printf '\nPAM\n'
if [[ -e /etc/pam.d/vellum-shell ]]; then
  act sudo rm -f /etc/pam.d/vellum-shell
else
  note "/etc/pam.d/vellum-shell mar nincs"
fi

if [[ $with_sddm == true ]]; then
  printf '\nSDDM tema\n'
  if [[ -d /usr/share/sddm/themes/vellum-ink ]]; then
    act sudo rm -rf /usr/share/sddm/themes/vellum-ink
    note "az /etc/sddm.conf.d/ bejegyzeseit kezzel nezd at (Current=vellum-ink)"
  else
    note "a vellum-ink tema nincs telepitve"
  fi
fi

if [[ $purge_state == true ]]; then
  printf '\nAllapot es gyorsitotar\n'
  for dir in \
    "$HOME/.local/state/quickshell/vellum-shell" \
    "$HOME/.cache/vellum-shell"; do
    if [[ -d $dir ]]; then
      act rm -rf "$dir"
    fi
  done
fi

printf '\nSymlink\n'
if [[ -L $target_dir && $(readlink -f "$target_dir") == "$repo" ]]; then
  act rm -f "$target_dir"
elif [[ $target_dir == "$repo" ]]; then
  note "a repo maga van ezen az utvonalon, ezert marad: $target_dir"
elif [[ -e $target_dir ]]; then
  note "megorizve (nem erre a repora mutat): $target_dir"
fi

printf '\n'
if [[ $dry_run == true ]]; then
  printf 'Ez csak terv volt. Futtasd a --dry-run nelkul a tenyleges eltavolitashoz.\n'
else
  printf 'A Vellum Shell eltavolitva. A repo, a hatterkepek es a kepernyokepek megmaradtak.\n'
  printf 'A Hyprland ujratoltese: hyprctl reload\n'
fi
