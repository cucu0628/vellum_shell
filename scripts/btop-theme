#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
source_file=${1:-}
output_dir="$HOME/.config/btop/themes"
output="$output_dir/vellum.theme"

if [[ ! -r $source_file ]]; then
  current=""
  [[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
  source_file="$base/themes/$current/theme.conf"
fi

[[ -r $source_file ]] || exit 0

background="#1e1e2e"
foreground="#cdd6f4"
accent="#89b4fa"
surface="#181825"
muted="#9399b2"
selection=""
red=""
yellow=""
orange=""
green=""
cyan=""
magenta=""

while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value//[[:space:]\"]/}
  case "$key" in
    BACKGROUND) background=$value ;;
    FOREGROUND) foreground=$value ;;
    ACCENT|BORDER_FOREGROUND) accent=$value ;;
    SURFACE) surface=$value ;;
    MUTED) muted=$value ;;
    SELECTION) selection=$value ;;
    RED) red=$value ;;
    YELLOW) yellow=$value ;;
    ORANGE) orange=$value ;;
    GREEN) green=$value ;;
    CYAN) cyan=$value ;;
    MAGENTA) magenta=$value ;;
  esac
done < "$source_file"

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#1e1e2e"
valid_color "$foreground" || foreground="#cdd6f4"
valid_color "$accent" || accent="#89b4fa"
valid_color "$surface" || surface="#181825"
valid_color "$muted" || muted="#9399b2"

mix() {
  local first=${1#\#} second=${2#\#} weight=$3 channel a b mixed result=""
  for channel in 0 2 4; do
    a=$((16#${first:channel:2}))
    b=$((16#${second:channel:2}))
    mixed=$(((a * weight + b * (100 - weight)) / 100))
    printf -v result '%s%02x' "$result" "$mixed"
  done
  printf '#%s' "$result"
}

graph_text=$(mix "$muted" "$foreground" 70)
valid_color "$selection" || selection="$accent"
valid_color "$cyan" || cyan=$(mix "$accent" "$foreground" 75)
valid_color "$green" || green=$(mix "#a6e3a1" "$accent" 70)
valid_color "$yellow" || yellow=$(mix "#f9e2af" "$accent" 70)
valid_color "$orange" || orange=$(mix "#fab387" "$accent" 70)
valid_color "$red" || red=$(mix "#f38ba8" "$accent" 70)
valid_color "$magenta" || magenta=$(mix "#cba6f7" "$accent" 70)

mkdir -p "$output_dir"
tmp=$(mktemp "$output_dir/.vellum_shell.theme.XXXXXX")
trap 'rm -f "$tmp"' EXIT

cat > "$tmp" <<EOF
# Generated by vellum_shell.

theme[main_bg]="$background"
theme[main_fg]="$foreground"
theme[title]="$accent"
theme[hi_fg]="$accent"
theme[selected_bg]="$selection"
theme[selected_fg]="$foreground"
theme[inactive_fg]="$muted"
theme[graph_text]="$graph_text"
theme[proc_misc]="$cyan"

theme[cpu_box]="$accent"
theme[mem_box]="$muted"
theme[net_box]="$muted"
theme[proc_box]="$muted"
theme[div_line]="$surface"

theme[temp_start]="$green"
theme[temp_mid]="$yellow"
theme[temp_end]="$red"

theme[cpu_start]="$green"
theme[cpu_mid]="$yellow"
theme[cpu_end]="$red"

theme[free_start]="$green"
theme[free_mid]="$cyan"
theme[free_end]="$accent"

theme[cached_start]="$cyan"
theme[cached_mid]="$accent"
theme[cached_end]="$magenta"

theme[available_start]="$accent"
theme[available_mid]="$cyan"
theme[available_end]="$foreground"

theme[used_start]="$yellow"
theme[used_mid]="$orange"
theme[used_end]="$red"

theme[download_start]="$green"
theme[download_mid]="$cyan"
theme[download_end]="$accent"

theme[upload_start]="$accent"
theme[upload_mid]="$magenta"
theme[upload_end]="$red"
EOF

if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
  mv "$tmp" "$output"
fi
