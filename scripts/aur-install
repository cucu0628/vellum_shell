#!/usr/bin/env bash
# Regi publikus nev: a launcher mar a disztribuciofuggetlen community-install
# segedet hasznalja, de kulso billentyuparancsok kedveert ez az alias megmarad.
set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
exec "$SCRIPT_DIR/community-install" "$@"
