#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
themes="$base/themes"
current=""
[[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")

emit_theme() {
  local slug=$1 conf=$2 kind=${3:-static}
  local name=$slug bg="#1e1e2e" fg="#cdd6f4" accent="#89b4fa" surface="#181825" muted="#9399b2" icon_theme="Yaru-dark"
  [[ -r $conf ]] || return 0

  while IFS= read -r line; do
    local key value
    key=${line%%=*}
    value=${line#*=}
    key=$(printf '%s' "$key" | tr -d '[:space:]')
    value=$(printf '%s' "$value" | tr -d '"' | xargs)
    case "$key" in
      NAME) name=$value ;;
      BACKGROUND) bg=$value ;;
      FOREGROUND) fg=$value ;;
      ACCENT|BORDER_FOREGROUND) accent=$value ;;
      SURFACE) surface=$value ;;
      MUTED) muted=$value ;;
      LIGHT_FOREGROUND) muted=$value ;;
      ICON_THEME) icon_theme=$value ;;
    esac
    case "$line" in
      'env = BACKGROUND,'*) bg=${line#*,}; [[ $bg == '##'* ]] && bg="#${bg#??}" ;;
      'env = FOREGROUND,'*) fg=${line#*,}; [[ $fg == '##'* ]] && fg="#${fg#??}" ;;
      'env = BORDER_FOREGROUND,'*) accent=${line#*,}; [[ $accent == '##'* ]] && accent="#${accent#??}" ;;
    esac
  done < "$conf"

  local marker=""
  [[ $slug == "$current" ]] && marker="current"
  printf '%s|%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$name" "$slug" "$marker" "$bg" "$fg" "$accent" "$surface" "$muted" "$kind" "$icon_theme"
}

emit_theme "dynamic-matugen" "$themes/dynamic-matugen/theme.conf" "dynamic"

[[ -d $themes ]] || exit 0
for dir in "$themes"/*; do
  [[ -d $dir ]] || continue
  slug=${dir##*/}
  [[ $slug == "dynamic-matugen" ]] && continue
  emit_theme "$slug" "$dir/theme.conf" "static"
done | sort
