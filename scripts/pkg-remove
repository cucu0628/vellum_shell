#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

platform=$(vellum_platform 2>/dev/null || true)
[[ -n $platform ]] || die "only Arch Linux, CachyOS and Fedora Linux are supported"

if (( $# > 0 )); then
  packages=("$@")
else
  require_fzf
  case "$platform" in
    arch)
      mapfile -t packages < <(pacman -Qqe | sort -u | fzf_many "remove packages" "pacman -Qi {} 2>/dev/null || true")
      ;;
    fedora)
      mapfile -t packages < <(dnf repoquery --userinstalled --queryformat '%{name}' 2>/dev/null \
        | sort -u | fzf_many "remove packages" "dnf info --installed {} 2>/dev/null || true")
      ;;
  esac
fi

(( ${#packages[@]} > 0 )) || die "no package selected"
printf 'Removing: %s\n' "${packages[*]}"
case "$platform" in
  arch) sudo pacman -Rns "${packages[@]}" ;;
  fedora) sudo dnf remove "${packages[@]}" ;;
esac
pause
