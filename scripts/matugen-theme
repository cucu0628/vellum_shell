#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
bgdir="$HOME/Pictures/wallpapers"
wallpaper=${1:-}
out_dir="$base/themes/dynamic-matugen"
out="$out_dir/theme.conf"

[[ -n $wallpaper && -r $wallpaper ]] || wallpaper=""
[[ -n $wallpaper ]] || { [[ -r "$base/current-wallpaper" ]] && wallpaper=$(<"$base/current-wallpaper"); }
# Fall back to the first wallpaper on disk; if there is none, leave it empty and
# the built-in palette below is used instead.
[[ -r $wallpaper ]] || wallpaper=$(find "$bgdir" -maxdepth 1 -type f \
  \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o -iname '*.gif' \) \
  2>/dev/null | sort | head -n 1)
[[ -r $wallpaper ]] || wallpaper=""

background="#15130c"
foreground="#e8e2d4"
accent="#d8c770"
surface="#222017"
muted="#ccc6b5"
selection="#3b3827"
dark_background="#0e0d08"
darker_background="#090805"
lighter_background="#222017"
dark_foreground="#777267"
light_foreground="#ccc6b5"
bright_foreground="#fff8e8"
red="#d87970"
orange="#d79a62"
cyan="#7db5a8"
blue="#82a9c8"
magenta="#bc91bd"

if command -v matugen >/dev/null 2>&1 && command -v jq >/dev/null 2>&1 && [[ -r $wallpaper ]]; then
  # The most saturated sample is often a tiny highlight and can tint an
  # otherwise neutral wallpaper incorrectly. Use Matugen's dominant extracted
  # source colour for a stable palette that reflects the whole image.
  fallback_color="#808080"
  json=$(matugen image "$wallpaper" --json hex --dry-run --mode dark --type scheme-tonal-spot \
    --source-color-index 0 --fallback-color "$fallback_color" 2>/dev/null || true)
  # Matugen otherwise falls back to blue when a monochrome image has no usable
  # source colour. Keep such wallpapers neutral instead of inventing a hue.
  if [[ $(jq -r '.colors.source_color.default.color // empty' <<<"$json") == "$fallback_color" ]]; then
    json=$(matugen image "$wallpaper" --json hex --dry-run --mode dark --type scheme-monochrome \
      --source-color-index 0 --fallback-color "$fallback_color" 2>/dev/null || true)
  fi
  if [[ -n $json ]]; then
    background=$(jq -r '.colors.background.default.color // .colors.surface.default.color // empty' <<<"$json")
    foreground=$(jq -r '.colors.on_surface.default.color // .colors.on_background.default.color // empty' <<<"$json")
    accent=$(jq -r '.colors.primary.default.color // .colors.secondary.default.color // empty' <<<"$json")
    surface=$(jq -r '.colors.surface_container.default.color // .colors.surface.default.color // empty' <<<"$json")
    muted=$(jq -r '.colors.on_surface_variant.default.color // .colors.outline.default.color // empty' <<<"$json")
    selection=$(jq -r '.colors.secondary_container.default.color // .colors.surface_container_high.default.color // empty' <<<"$json")
    dark_background=$(jq -r '.colors.surface_dim.default.color // .colors.background.default.color // empty' <<<"$json")
    darker_background=$(jq -r '.colors.surface_container_lowest.default.color // .colors.surface_dim.default.color // empty' <<<"$json")
    lighter_background=$(jq -r '.colors.surface_container_high.default.color // .colors.surface_container.default.color // empty' <<<"$json")
    dark_foreground=$(jq -r '.colors.outline.default.color // empty' <<<"$json")
    light_foreground=$(jq -r '.colors.on_surface_variant.default.color // empty' <<<"$json")
    bright_foreground=$(jq -r '.colors.on_surface.default.color // empty' <<<"$json")
    red=$(jq -r '.colors.error.default.color // empty' <<<"$json")
    orange=$(jq -r '.colors.tertiary.default.color // empty' <<<"$json")
    cyan=$(jq -r '.colors.secondary.default.color // empty' <<<"$json")
    blue=$(jq -r '.colors.primary.default.color // empty' <<<"$json")
    magenta=$(jq -r '.colors.tertiary.default.color // empty' <<<"$json")
  fi
fi

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#15130c"
valid_color "$foreground" || foreground="#e8e2d4"
valid_color "$accent" || accent="#d8c770"
valid_color "$surface" || surface="#222017"
valid_color "$muted" || muted="#ccc6b5"
valid_color "$selection" || selection="$surface"
valid_color "$dark_background" || dark_background="$background"
valid_color "$darker_background" || darker_background="$dark_background"
valid_color "$lighter_background" || lighter_background="$surface"
valid_color "$dark_foreground" || dark_foreground="$muted"
valid_color "$light_foreground" || light_foreground="$foreground"
valid_color "$bright_foreground" || bright_foreground="$foreground"
valid_color "$red" || red="#d87970"
valid_color "$orange" || orange="#d79a62"
valid_color "$cyan" || cyan="$accent"
valid_color "$blue" || blue="$accent"
valid_color "$magenta" || magenta="$accent"

mix() {
  local first=${1#\#} second=${2#\#} weight=$3 channel a b mixed result=""
  for channel in 0 2 4; do
    a=$((16#${first:channel:2}))
    b=$((16#${second:channel:2}))
    mixed=$(((a * weight + b * (100 - weight)) / 100))
    printf -v result '%s%02x' "$result" "$mixed"
  done
  printf '#%s' "$result"
}

yellow=$(mix "#e0af68" "$accent" 72)
green=$(mix "#9ece6a" "$accent" 72)
brown=$(mix "#8b5e4a" "$accent" 70)
bright_red=$(mix "$red" "$foreground" 82)
bright_yellow=$(mix "$yellow" "$foreground" 82)
bright_green=$(mix "$green" "$foreground" 82)
bright_cyan=$(mix "$cyan" "$foreground" 82)
bright_blue=$(mix "$blue" "$foreground" 82)
bright_magenta=$(mix "$magenta" "$foreground" 82)

mkdir -p "$out_dir"
tmp=$(mktemp "$out_dir/.theme.XXXXXX")
trap 'rm -f "$tmp"' EXIT
{
  printf 'NAME=Dynamic / Matugen\n'
  printf 'MODE=dark\n\n'
  printf 'ACCENT=%s\n' "$accent"
  printf 'SELECTION=%s\n' "$selection"
  printf 'MUTED=%s\n\n' "$muted"
  printf 'BACKGROUND=%s\n' "$background"
  printf 'DARK_BACKGROUND=%s\n' "$dark_background"
  printf 'DARKER_BACKGROUND=%s\n' "$darker_background"
  printf 'LIGHTER_BACKGROUND=%s\n\n' "$lighter_background"
  printf 'FOREGROUND=%s\n' "$foreground"
  printf 'DARK_FOREGROUND=%s\n' "$dark_foreground"
  printf 'LIGHT_FOREGROUND=%s\n' "$light_foreground"
  printf 'BRIGHT_FOREGROUND=%s\n\n' "$bright_foreground"
  printf 'RED=%s\n' "$red"
  printf 'YELLOW=%s\n' "$yellow"
  printf 'ORANGE=%s\n' "$orange"
  printf 'GREEN=%s\n' "$green"
  printf 'CYAN=%s\n' "$cyan"
  printf 'BLUE=%s\n' "$blue"
  printf 'MAGENTA=%s\n' "$magenta"
  printf 'BROWN=%s\n\n' "$brown"
  printf 'BRIGHT_RED=%s\n' "$bright_red"
  printf 'BRIGHT_YELLOW=%s\n' "$bright_yellow"
  printf 'BRIGHT_GREEN=%s\n' "$bright_green"
  printf 'BRIGHT_CYAN=%s\n' "$bright_cyan"
  printf 'BRIGHT_BLUE=%s\n' "$bright_blue"
  printf 'BRIGHT_MAGENTA=%s\n\n' "$bright_magenta"
  printf 'SURFACE=%s\n' "$surface"
  printf 'ICON_THEME=auto\n'
} > "$tmp"

mv "$tmp" "$out"
trap - EXIT

cat "$out"
