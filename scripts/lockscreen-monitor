#!/bin/sh

set -eu

base=${VELLUM_SHELL_DIR:-$(cd -- "$(dirname -- "$0")/.." && pwd)}
settings="$base/settings.json"

# A valasztott monitor a `settings.json` `lockScreen.monitor` kulcsa (a shell
# `core/SettingsStore.qml`-je ugyanezt figyeli).
saved_monitor() {
    [ -r "$settings" ] || return 0
    jq -r '.lockScreen.monitor // empty | tostring' "$settings" 2>/dev/null || true
}

save_monitor() {
    tmp=$(mktemp "$settings.XXXXXX")
    if [ -s "$settings" ]; then
        if ! jq --arg monitor "$1" '.version = 1 | .lockScreen.monitor = $monitor' "$settings" > "$tmp"; then
            rm -f "$tmp"
            printf '%s is not valid JSON\n' "$settings" >&2
            exit 1
        fi
    else
        jq -n --arg monitor "$1" '{version: 1, lockScreen: {monitor: $monitor}}' > "$tmp"
    fi
    mv -f "$tmp" "$settings"
}

monitors() {
    hyprctl monitors -j 2>/dev/null | jq -r '.[].name'
}

# Egy `monitors | while ... exit 0` szerkezet ures listara IGAZAT ad (a torzs
# le sem fut), ezert hyprctl nelkul barmit elfogadott. A grep ures bemenetre
# helyesen bukik.
has_monitor() {
    monitors | grep -qxF -- "$1"
}

current() {
    saved=$(saved_monitor)

    if [ -n "$saved" ] && has_monitor "$saved"; then
        printf '%s\n' "$saved"
        return
    fi

    focused=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | .name' | sed -n '1p')
    if [ -n "$focused" ]; then
        printf '%s\n' "$focused"
    else
        monitors | sed -n '1p'
    fi
}

case ${1:-list} in
    current)
        current
        ;;
    list)
        selected=$(current)
        monitors | while IFS= read -r monitor; do
            label=$monitor
            [ "$monitor" = "$selected" ] && label="$monitor [current]"
            printf '%s|%s\n' "$label" "$monitor"
        done
        ;;
    set)
        requested=${2:-}
        [ -n "$requested" ] || exit 2
        has_monitor "$requested" || exit 2
        save_monitor "$requested"
        # A greeter ugyanazon a kijelzon kerje a jelszot. A fajlt a
        # greeter-install hozza letre es chownolja; nelkule nincs greeter.
        greeter_screen=/var/lib/vellum-greeter/input-screen
        if [ -w "$greeter_screen" ]; then
            printf '%s\n' "$requested" > "$greeter_screen"
        fi
        ;;
    *)
        exit 2
        ;;
esac
