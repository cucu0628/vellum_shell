#!/bin/sh

set -u

# A Fedora telepito a disztribucioban nem csomagolt wayfreeze binarist ide teszi,
# es a Snip kepszerkeszto is itt van. A grafikus munkamenet PATH-ja nem minden
# bejelentkezesnel tartalmazza.
#
# A kijeloles alatti kepfagyasztas nem kotelezo: wayfreeze, ha van; kulonben
# hyprpicker (a Hyprland sajat eszkoze, a hyprshot is igy fagyaszt); ha egyik
# sincs, fagyasztas nelkul megy. A kepet mindharom esetben a kijeloles ELOTT
# vesszuk, es abbol vagjuk ki a kijelolt reszt, igy az eredmeny ugyanaz.
PATH="$HOME/.local/bin:$PATH"
export PATH

mode=${1:-smart}

# A slurp, ha a bemenete nem terminal, elore megadott teglalapokat var onnan, es
# addig meg sem jelenik. A shell Processe nyitott, de soha le nem zart csovet ad
# bemenetnek, igy a kijeloles orokre beragadt (es vele minden tovabbi Print).
# A smart mod a sajat ablakdobozait kulon csovon adja at, arra ez nem hat.
exec </dev/null

missing=""
for command in grim slurp magick hyprctl jq; do
    if ! command -v "$command" >/dev/null 2>&1; then
        missing="$missing $command"
    fi
done

if [ -n "$missing" ]; then
    notify-send -u critical "Screenshot unavailable" "Install the missing tools:$missing"
    exit 1
fi

background="191724"
accent="ebbcba"
theme_name=$(cat "$HOME/.config/quickshell/vellum_shell/current-theme" 2>/dev/null || true)
theme_file="$HOME/.config/quickshell/vellum_shell/themes/$theme_name/theme.conf"
if [ -r "$theme_file" ]; then
    while IFS='=' read -r key value; do
        value=${value#\#}
        case "$key" in
            BACKGROUND) background=$value ;;
            ACCENT) accent=$value ;;
        esac
    done < "$theme_file"
fi

freeze_pid=""
freeze_ready=""
snapshot=""
monitors=""
canvas_x=0
canvas_y=0

prepare_frozen_snapshot() {
    if [ -z "$monitors" ]; then
        monitors=$(hyprctl monitors -j)
    fi
    canvas_x=$(printf '%s' "$monitors" | jq '[.[].x] | min')
    canvas_y=$(printf '%s' "$monitors" | jq '[.[].y] | min')

    if command -v wayfreeze >/dev/null 2>&1; then
        freeze_ready=$(mktemp)
        rm -f "$freeze_ready"
        wayfreeze --hide-cursor --after-freeze-cmd "touch '$freeze_ready'" --after-freeze-timeout 0 &
        freeze_pid=$!

        attempts=0
        while [ ! -e "$freeze_ready" ]; do
            if ! kill -0 "$freeze_pid" 2>/dev/null || [ "$attempts" -ge 200 ]; then
                notify-send -u critical "Screenshot failed" "The screen freezer did not become ready."
                exit 1
            fi
            attempts=$((attempts + 1))
            sleep 0.01
        done
        rm -f "$freeze_ready"
        freeze_ready=""
    elif command -v hyprpicker >/dev/null 2>&1; then
        # -r: minden kijelzo fagyjon; -z/-d: se nagyito, se szinelonezet.
        # Nincs "kesz" jelzese, ezert rovid varakozas, amig az elso kepkocka kint van.
        hyprpicker -r -z -d -q >/dev/null 2>&1 &
        freeze_pid=$!
        sleep 0.2
        if ! kill -0 "$freeze_pid" 2>/dev/null; then
            freeze_pid=""
        fi
    fi

    snapshot=$(mktemp --suffix=.ppm)
    if ! grim -s 1 -t ppm "$snapshot"; then
        notify-send -u critical "Screenshot failed" "Could not capture the frozen desktop."
        exit 1
    fi
}

stop_freeze() {
    if [ -n "$freeze_pid" ]; then
        kill "$freeze_pid" 2>/dev/null || true
        wait "$freeze_pid" 2>/dev/null || true
        freeze_pid=""
    fi
}

# A kijeloles hatterben fut, es `wait`-tel varunk ra: az elotérben futo parancs
# alatt a shell nem kezelne a leallitasi jelet (a trap csak utana futna le),
# a `wait` viszont megszakithato. Az eredmeny a `geometry` valtozoba kerul.
selection_file=""
select_area() {
    selection_file=$(mktemp)
    if [ -n "$1" ]; then
        printf '%s' "$1" | slurp -o -d -F monospace -b "${background}c4" -c "${accent}ff" -s "${accent}2e" -B "${accent}0a" -w 3 > "$selection_file" &
    else
        slurp -d -F monospace -b "${background}c4" -c "${accent}ff" -s "${accent}2e" -w 3 > "$selection_file" &
    fi
    wait $!
    status=$?
    geometry=$(cat "$selection_file")
    rm -f "$selection_file"
    selection_file=""
    return $status
}

cleanup() {
    [ -n "$selection_file" ] && rm -f "$selection_file"
    stop_freeze
    [ -n "$freeze_ready" ] && rm -f "$freeze_ready"
    [ -n "$snapshot" ] && rm -f "$snapshot"
}

trap cleanup EXIT
# Ha a shell egy uj Print miatt leallit egy fuggo kijelolest, a gyerekek (slurp,
# fagyaszto) se maradjanak a kepernyon.
trap 'pkill -P $$ 2>/dev/null; exit 130' HUP INT TERM

if command -v xdg-user-dir >/dev/null 2>&1; then
    pictures_dir=$(xdg-user-dir PICTURES 2>/dev/null || true)
fi
pictures_dir=${pictures_dir:-"$HOME/Pictures"}
output_dir="$pictures_dir/Screenshots"
mkdir -p "$output_dir"

timestamp=$(date '+%Y-%m-%d_%H-%M-%S_%3N')
output="$output_dir/screenshot_${timestamp}.png"

case "$mode" in
    smart)
        monitors=$(hyprctl monitors -j)
        window_boxes=$(hyprctl clients -j | jq -r --argjson monitors "$monitors" '
                [$monitors[].activeWorkspace.id, $monitors[].specialWorkspace.id] as $visible
                | .[]
                | select(.mapped == true and .hidden == false)
                | select(.size[0] > 0 and .size[1] > 0)
                | select(.workspace.id as $id | $visible | index($id) != null)
                | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1]) \(.title | gsub("[\\r\\n]"; " "))"
            ')
        prepare_frozen_snapshot
        select_area "$window_boxes" || exit 0
        ;;
    window)
        geometry=$(hyprctl activewindow -j | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')
        ;;
    workspace)
        geometry=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | "\(.x),\(.y) \((.width / .scale) | floor)x\((.height / .scale) | floor)"')
        ;;
    region)
        prepare_frozen_snapshot
        select_area "" || exit 0
        ;;
    *)
        notify-send -u critical "Screenshot failed" "Unknown capture mode: $mode"
        exit 2
        ;;
esac

if [ -z "$geometry" ]; then
    rm -f "$output"
    exit 1
fi

stop_freeze

if [ -n "$snapshot" ]; then
    coordinates=${geometry%% *}
    dimensions=${geometry#* }
    selection_x=${coordinates%,*}
    selection_y=${coordinates#*,}
    selection_width=${dimensions%x*}
    selection_height=${dimensions#*x}
    crop_x=$((selection_x - canvas_x))
    crop_y=$((selection_y - canvas_y))

    if ! magick "$snapshot" -crop "${selection_width}x${selection_height}+${crop_x}+${crop_y}" +repage "$output"; then
        rm -f "$output"
        exit 1
    fi
elif ! grim -g "$geometry" "$output"; then
    rm -f "$output"
    exit 1
fi

if [ ! -s "$output" ]; then
    rm -f "$output"
    exit 1
fi

if command -v wl-copy >/dev/null 2>&1; then
    wl-copy --type image/png < "$output"
fi

(
    action=$(notify-send -a "Vellum Shell" -i "$output" -A "default=Edit with Snip" "Screenshot captured" "Saved to $output and copied to the clipboard." || true)
    if [ "$action" = "default" ] && command -v snip >/dev/null 2>&1; then
        snip "$output" >/dev/null 2>&1 &
    fi
) >/dev/null 2>&1 &
