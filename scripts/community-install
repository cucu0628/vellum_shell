#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
. "$SCRIPT_DIR/lib.sh"

platform=$(vellum_platform 2>/dev/null || true)
[[ -n $platform ]] || die "only Arch Linux, CachyOS and Fedora Linux are supported"

if [[ $platform == arch ]]; then
  helper=""
  for candidate in paru yay; do
    if has "$candidate"; then
      helper=$candidate
      break
    fi
  done
  [[ -n $helper ]] || die "install paru or yay first"

  if (( $# > 0 )); then
    packages=("$@")
  else
    require_fzf
    mapfile -t packages < <("$helper" -Slq aur 2>/dev/null \
      | sort -u | fzf_many "AUR install" "$helper -Si {} 2>/dev/null || true")
  fi

  (( ${#packages[@]} > 0 )) || die "no package selected"
  printf 'Installing from AUR with %s: %s\n' "$helper" "${packages[*]}"
  "$helper" -S --needed "${packages[@]}"
  pause
  exit 0
fi

has dnf || die "dnf is required on Fedora"
dnf copr --help >/dev/null 2>&1 || die "install dnf5-plugins (or dnf-plugins-core) first"

copr=${1:-$(prompt "COPR repository (owner/project)")}
if (( $# > 0 )); then shift; fi
[[ $copr =~ ^@?[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || \
  die "COPR must use the owner/project form"

sudo dnf copr enable "$copr"

if (( $# > 0 )); then
  packages=("$@")
else
  package=$(prompt "Package to install (leave empty to only enable the COPR)")
  packages=()
  [[ -n $package ]] && packages+=("$package")
fi

if (( ${#packages[@]} > 0 )); then
  printf 'Installing from COPR %s: %s\n' "$copr" "${packages[*]}"
  sudo dnf install "${packages[@]}"
else
  printf 'Enabled COPR: %s\n' "$copr"
fi
pause
