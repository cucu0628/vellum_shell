#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
source_file=${1:-}
output_dir="$HOME/.config/hypr"
output="$output_dir/colors.lua"

if [[ ! -r $source_file ]]; then
  current=""
  [[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
  source_file="$base/themes/$current/theme.conf"
fi

[[ -r $source_file ]] || exit 0

background="#1e1e2e"
foreground="#cdd6f4"
accent="#89b4fa"
muted="#9399b2"

while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value//[[:space:]\"]/}
  case "$key" in
    BACKGROUND) background=$value ;;
    FOREGROUND) foreground=$value ;;
    ACCENT|BORDER_FOREGROUND) accent=$value ;;
    MUTED) muted=$value ;;
  esac
done < "$source_file"

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#1e1e2e"
valid_color "$foreground" || foreground="#cdd6f4"
valid_color "$accent" || accent="#89b4fa"
valid_color "$muted" || muted="#9399b2"

mix() {
  local first=${1#\#} second=${2#\#} weight=$3 channel a b mixed result=""
  for channel in 0 2 4; do
    a=$((16#${first:channel:2}))
    b=$((16#${second:channel:2}))
    mixed=$(((a * weight + b * (100 - weight)) / 100))
    printf -v result '%s%02x' "$result" "$mixed"
  done
  printf '#%s' "$result"
}

locked_accent=$(mix "$foreground" "$accent" 55)
active=${accent#\#}
inactive=${muted#\#}
locked_active=${locked_accent#\#}

mkdir -p "$output_dir"
tmp=$(mktemp "$output_dir/.colors.lua.XXXXXX")
trap 'rm -f "$tmp"' EXIT

{
  printf '%s\n' '-- Generated by vellum_shell. Import this file from hyprland.lua.'
  printf 'hl.config({\n'
  printf '\tgeneral = {\n'
  printf '\t\tcol = {\n'
  printf '\t\t\tactive_border = "rgb(%s)",\n' "$active"
  printf '\t\t\tinactive_border = "rgb(%s)",\n' "$inactive"
  printf '\t\t},\n'
  printf '\t},\n'
  printf '\tgroup = {\n'
  printf '\t\tcol = {\n'
  printf '\t\t\tborder_active = "rgb(%s)",\n' "$active"
  printf '\t\t\tborder_inactive = "rgb(%s)",\n' "$inactive"
  printf '\t\t\tborder_locked_active = "rgb(%s)",\n' "$locked_active"
  printf '\t\t\tborder_locked_inactive = "rgb(%s)",\n' "$inactive"
  printf '\t\t},\n'
  printf '\t\tgroupbar = {\n'
  printf '\t\t\tcol = {\n'
  printf '\t\t\t\tactive = "rgb(%s)",\n' "$active"
  printf '\t\t\t\tinactive = "rgb(%s)",\n' "$inactive"
  printf '\t\t\t\tlocked_active = "rgb(%s)",\n' "$locked_active"
  printf '\t\t\t\tlocked_inactive = "rgb(%s)",\n' "$inactive"
  printf '\t\t\t},\n'
  printf '\t\t},\n'
  printf '\t},\n'
  printf '})\n'
} > "$tmp"

if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
  mv "$tmp" "$output"
fi
