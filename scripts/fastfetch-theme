#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
fastfetch_dir="$HOME/.config/fastfetch"
source_file=${1:-}

if [[ ! -r $source_file ]]; then
  current=""
  [[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
  source_file="$base/themes/$current/theme.conf"
fi

[[ -r $source_file ]] || exit 0
mkdir -p "$fastfetch_dir"
logo_template="$fastfetch_dir/vellum.template.svg"
[[ -r $logo_template ]] || logo_template="$base/assets/vellum-logo.svg"
[[ -r $logo_template ]] || exit 0

background="#1e1e2e"
foreground="#cdd6f4"
accent="#89b4fa"
muted="#9399b2"

while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value//[[:space:]\"]/}
  case "$key" in
    BACKGROUND) background=$value ;;
    FOREGROUND) foreground=$value ;;
    ACCENT|BORDER_FOREGROUND) accent=$value ;;
    MUTED) muted=$value ;;
  esac
done < "$source_file"

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#1e1e2e"
valid_color "$foreground" || foreground="#cdd6f4"
valid_color "$accent" || accent="#89b4fa"
valid_color "$muted" || muted="#9399b2"

render_template() {
  sed \
    -e "s|@BACKGROUND@|$background|g" \
    -e "s|@FOREGROUND@|$foreground|g" \
    -e "s|@ACCENT@|$accent|g" \
    -e "s|@MUTED@|$muted|g" \
    -e "s|#e8ddc7|$foreground|g" \
    "$1"
}

update_text_file() {
  local template=$1 output=$2 tmp
  tmp=$(mktemp "$fastfetch_dir/.fastfetch-theme.XXXXXX")
  render_template "$template" > "$tmp"
  if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
    mv "$tmp" "$output"
  else
    rm -f "$tmp"
  fi
}

if [[ -r "$fastfetch_dir/config.template.jsonc" ]]; then
  update_text_file "$fastfetch_dir/config.template.jsonc" "$fastfetch_dir/config.jsonc"
fi
update_text_file "$logo_template" "$fastfetch_dir/vellum.svg"

if command -v magick >/dev/null 2>&1; then
  tmp_png=$(mktemp "$fastfetch_dir/.vellum.XXXXXX.png")
  trap 'rm -f "$tmp_png"' EXIT
  magick -background none "$fastfetch_dir/vellum.svg" -trim +repage \
    -resize 768x768 -strip "$tmp_png"
  if [[ ! -r "$fastfetch_dir/vellum.png" ]] || ! cmp -s "$tmp_png" "$fastfetch_dir/vellum.png"; then
    mv "$tmp_png" "$fastfetch_dir/vellum.png"
  fi
fi
