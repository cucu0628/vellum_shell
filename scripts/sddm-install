#!/usr/bin/env bash
# Vellum Ink SDDM tema telepitese / frissitese.
#
#   sddm-install              -> paletta szinkron + masolas /usr/share/sddm/themes/vellum-ink ala
#   sddm-install --default    -> ugyanez, plusz beallitja aktiv SDDM temanak
#   sddm-install --layout     -> ugyanez, plusz X11 monitorelrendezes az SDDM-hez
#   sddm-install --preview    -> elinditja a greetert teszt modban (nem kell root)
set -euo pipefail

base="$(cd "$(dirname "$0")/.." && pwd)"
src="$base/sddm/vellum-ink"
dest="/usr/share/sddm/themes/vellum-ink"
conf_dir="/etc/sddm.conf.d"
conf_file="$conf_dir/10-vellum-ink.conf"
layout_conf="$conf_dir/20-vellum-ink-layout.conf"
layout_src="$src/Xsetup"
layout_dest="/etc/sddm/Xsetup"

[[ -d $src ]] || { printf 'error: theme source not found: %s\n' "$src" >&2; exit 1; }

set_default=0
set_layout=0
preview=0
for arg in "$@"; do
  case "$arg" in
    --default|-d) set_default=1 ;;
    --layout|-l) set_layout=1 ;;
    --preview|-p) preview=1 ;;
    *) printf 'error: unknown option: %s\n' "$arg" >&2; exit 1 ;;
  esac
done

# A paletta mindig az aktualis Vellum Shell temabol keszul. A generatorok a
# backendbe koltoztek, ezert azt kerjuk meg ra; a --no-zen azert kell, hogy egy
# greeter-telepites ne nyuljon a bongeszo profiljahoz.
#
# Ha a backend nincs telepitve, a repoban levo theme.conf-ot masoljuk tovabb --
# az minden temavaltaskor frissul, tehat legfeljebb elavult, de nem hianyzik.
vellum="$HOME/.local/bin/vellum"
if [[ -x $vellum && -r "$base/current-theme" ]]; then
  "$vellum" theme apply "$(<"$base/current-theme")" --no-zen >/dev/null 2>&1 || true
else
  printf 'figyelmeztetes: a Vellum backend nem elerheto, a meglevo paletta kerul telepitesre\n' >&2
fi
((set_layout)) && sh "$base/scripts/sddm-layout" >/dev/null 2>&1 || true

if ((preview)); then
  greeter=$(command -v sddm-greeter-qt6 || command -v sddm-greeter || true)
  [[ -n $greeter ]] || { printf 'error: sddm-greeter not found\n' >&2; exit 1; }
  exec "$greeter" --test-mode --theme "$src"
fi

if [[ $EUID -ne 0 ]]; then
  printf 'root jog kell a telepiteshez, ujrainditas sudo-val...\n'
  exec sudo -- "$0" "$@"
fi

install -d -m 755 "$dest"
find "$dest" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
install -m 644 "$src"/*.qml "$src"/theme.conf "$src"/metadata.desktop "$dest/"

# Csak a theme.conf kerul a felhasznalo tulajdonaba, hogy a temavaltas root
# nelkul frissithesse a paletta szineit. A QML root tulajdonu marad.
owner=${SUDO_USER:-$(stat -c %U "$src")}
if [[ -n $owner ]] && id "$owner" >/dev/null 2>&1; then
  chown "$owner" "$dest/theme.conf"
  printf 'palette owner: %s (%s)\n' "$owner" "$dest/theme.conf"
fi

printf 'installed: %s\n' "$dest"

if ((set_default)); then
  install -d -m 755 "$conf_dir"
  cat > "$conf_file" <<'EOF'
[Theme]
Current=vellum-ink
EOF
    chmod 644 "$conf_file"
    printf 'active theme set in %s\n' "$conf_file"
else
  printf 'aktivalas: sudo %s --default\n' "$0"
fi

if ((set_layout)); then
  if [[ -r $layout_src ]]; then
    install -d -m 755 "$conf_dir" "$(dirname "$layout_dest")"
    install -m 755 "$layout_src" "$layout_dest"
    cat > "$layout_conf" <<EOF
[X11]
DisplayCommand=$layout_dest
EOF
    chmod 644 "$layout_conf"
    printf 'monitor layout: %s (%s)\n' "$layout_dest" "$layout_conf"
    grep -E '^# Primary:' "$layout_dest" || true
  else
    printf 'warning: %s hianyzik, futtasd elobb felhasznalokent: %s\n' \
      "$layout_src" "$base/scripts/sddm-layout" >&2
  fi
fi
