#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
themes="$base/themes"
current=""
[[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")

file="$themes/$current/theme.conf"
if [[ ! -r $file ]]; then
  for dir in "$themes"/*; do
    [[ -r "$dir/theme.conf" ]] && file="$dir/theme.conf" && break
  done
fi

[[ -r $file ]] && cat "$file" || true
