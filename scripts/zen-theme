#!/usr/bin/env bash
set -euo pipefail

base="$HOME/.config/quickshell/vellum_shell"
source_file=${1:-}
output="$base/zen-theme.css"
content_output="$base/zen-content-theme.css"

if [[ ! -r $source_file ]]; then
  current=""
  [[ -r "$base/current-theme" ]] && current=$(<"$base/current-theme")
  source_file="$base/themes/$current/theme.conf"
fi

[[ -r $source_file ]] || exit 0

background="#1e1e2e"
foreground="#cdd6f4"
accent="#89b4fa"
surface="#181825"
muted="#9399b2"
selection=""
dark_background=""
lighter_background=""
red=""
yellow=""
orange=""
green=""
cyan=""
blue=""
magenta=""

while IFS='=' read -r key value; do
  key=${key//[[:space:]]/}
  value=${value//[[:space:]\"]/}
  case "$key" in
    BACKGROUND) background=$value ;;
    FOREGROUND) foreground=$value ;;
    ACCENT|BORDER_FOREGROUND) accent=$value ;;
    SURFACE) surface=$value ;;
    MUTED) muted=$value ;;
    SELECTION) selection=$value ;;
    DARK_BACKGROUND) dark_background=$value ;;
    LIGHTER_BACKGROUND) lighter_background=$value ;;
    RED) red=$value ;;
    YELLOW) yellow=$value ;;
    ORANGE) orange=$value ;;
    GREEN) green=$value ;;
    CYAN) cyan=$value ;;
    BLUE) blue=$value ;;
    MAGENTA) magenta=$value ;;
  esac
done < "$source_file"

valid_color() {
  [[ $1 =~ ^#[[:xdigit:]]{6}$ ]]
}

valid_color "$background" || background="#1e1e2e"
valid_color "$foreground" || foreground="#cdd6f4"
valid_color "$accent" || accent="#89b4fa"
valid_color "$surface" || surface="#181825"
valid_color "$muted" || muted="#9399b2"

mix() {
  local first=${1#\#} second=${2#\#} weight=$3 channel a b mixed result=""
  for channel in 0 2 4; do
    a=$((16#${first:channel:2}))
    b=$((16#${second:channel:2}))
    mixed=$(((a * weight + b * (100 - weight)) / 100))
    printf -v result '%s%02x' "$result" "$mixed"
  done
  printf '#%s' "$result"
}

valid_color "$selection" || selection="$accent"
valid_color "$dark_background" || dark_background="$background"
valid_color "$lighter_background" || lighter_background="$surface"
valid_color "$red" || red=$(mix "#ff5449" "$foreground" 70)
valid_color "$yellow" || yellow=$(mix "$foreground" "$accent" 75)
valid_color "$orange" || orange=$(mix "$accent" "$foreground" 85)
valid_color "$green" || green=$(mix "$muted" "$foreground" 65)
valid_color "$cyan" || cyan="$accent"
valid_color "$blue" || blue=$(mix "$accent" "$foreground" 70)
valid_color "$magenta" || magenta=$(mix "$accent" "$background" 35)

primary=$(mix "$accent" "$background" 45)
selection_text="$foreground"
url_color=$(mix "$muted" "$foreground" 75)
identity_pink=$(mix "$accent" "$foreground" 55)

tmp=$(mktemp "$base/.zen-theme.XXXXXX")
trap 'rm -f "$tmp"' EXIT

cat > "$tmp" <<EOF
/* Generated by vellum_shell. Import this file from Zen Browser's userChrome CSS. */
:root {
  color-scheme: dark !important;
  color: $foreground !important;
  --zen-primary-color: $primary !important;
  --toolbox-textcolor: $foreground !important;
  --toolbox-textcolor-inactive: $muted !important;
  --sidebar-text-color: $foreground !important;
  --lwt-text-color: $foreground !important;
  --lwt-tab-text: $foreground !important;
  --input-color: $foreground !important;
  --text-color: $foreground !important;
  --toolbar-color-scheme: dark !important;
  --content-color-scheme: dark !important;
  --ghost-opacity: 0.5 !important;
  --toolbarbutton-icon-fill: $accent !important;
  --toolbar-field-color: $foreground !important;
  --toolbar-field-focus-color: $foreground !important;
  --tab-selected-textcolor: $accent !important;
  --toolbar-color: $foreground !important;
  --arrowpanel-color: $foreground !important;
  --arrowpanel-background: $lighter_background !important;
  --zen-navigator-toolbox-background: $background !important;
  --zen-main-browser-background: $dark_background !important;
  --zen-main-browser-background-toolbar: $background !important;
}

#navigator-toolbox,
#TabsToolbar,
#tabbrowser-tabs,
zen-workspace {
  color: $foreground !important;
  --toolbox-textcolor: $foreground !important;
  --toolbar-color: $foreground !important;
  --tab-selected-textcolor: $foreground !important;
}

.tabbrowser-tab,
.tabbrowser-tab .tab-content,
.tabbrowser-tab .tab-label-container,
.tabbrowser-tab .tab-label,
.tabbrowser-tab .zen-tab-sublabel,
zen-folder .tab-group-label,
#navigator-toolbox label {
  color: $foreground !important;
}

.tabbrowser-tab[pending="true"] {
  opacity: 0.5 !important;
}

.tabbrowser-tab:is([selected], [visuallyselected], [multiselected="true"]) {
  opacity: 1 !important;
}

#urlbar-input,
.urlbarView-row,
.urlbarView-title,
.urlbarView-url {
  color: $foreground !important;
}

/* Zen adds compact-mode spacing on both sides of the floating sidebar. Keep
   the outer gutter, but remove the redundant gutter next to web content. */
:root[zen-compact-mode="true"]:not([zen-right-side="true"])
  #navigator-toolbox:not([animate="true"]) {
  padding-right: 0 !important;
}

:root[zen-compact-mode="true"][zen-right-side="true"]
  #navigator-toolbox:not([animate="true"]) {
  padding-left: 0 !important;
}

menupopup {
  color: $foreground !important;
  --panel-text-color: $foreground !important;
  --panel-background-color: $lighter_background !important;
  --button-text-color-menu: $foreground !important;
  --button-text-color-menu-hover: $foreground !important;
  --button-text-color-menu-active: $foreground !important;
  --button-text-color-menu-disabled: $muted !important;
  --button-background-color-menu-hover: $surface !important;
  --button-background-color-menu-active: $primary !important;
}

menupopup::part(content) {
  color: $foreground !important;
  background-color: $lighter_background !important;
}

menupopup :is(menu, menuitem):not([disabled]),
menupopup :is(menu, menuitem):not([disabled]) :is(.menu-text, .menu-accel) {
  color: $foreground !important;
}

menupopup :is(menu, menuitem)[disabled],
menupopup :is(menu, menuitem)[disabled] :is(.menu-text, .menu-accel) {
  color: $muted !important;
}

:is(panel, panelview, panelmultiview, .cui-widget-panel) {
  color: $foreground !important;
  --panel-text-color: $foreground !important;
  --panel-background-color: $lighter_background !important;
  --text-color: $foreground !important;
  --text-color-deemphasized: $muted !important;
  --button-text-color-menu: $foreground !important;
  --button-text-color-menu-hover: $foreground !important;
  --button-text-color-menu-active: $foreground !important;
  --button-text-color-menu-disabled: $muted !important;
  --button-background-color-menu-hover: $surface !important;
  --button-background-color-menu-active: $primary !important;
  --uei-button-color: $foreground !important;
}

:is(#appMenu-popup, #unified-extensions-panel) panelview,
:is(#appMenu-popup, #unified-extensions-panel) panelmultiview {
  color: $foreground !important;
  background-color: $lighter_background !important;
}

:is(#appMenu-popup, #unified-extensions-panel)
  :is(.subviewbutton, .toolbarbutton-1):not([disabled]),
:is(#appMenu-popup, #unified-extensions-panel)
  :is(.subviewbutton, .toolbarbutton-1):not([disabled])
  :is(.toolbarbutton-text, label, description) {
  color: $foreground !important;
  fill: $foreground !important;
}

:is(#appMenu-popup, #unified-extensions-panel)
  :is(.subviewbutton, .toolbarbutton-1)[disabled],
:is(#appMenu-popup, #unified-extensions-panel)
  :is(.subviewbutton, .toolbarbutton-1)[disabled]
  :is(.toolbarbutton-text, label, description) {
  color: $muted !important;
  fill: $muted !important;
}

#unified-extensions-panel
  :is(.unified-extensions-item-name, .panel-header, .panel-header > h1) {
  color: $foreground !important;
}

#unified-extensions-panel
  :is(.unified-extensions-item-message, .subview-subheader) {
  color: $muted !important;
}

#zen-browser-background {
  background-color: $dark_background !important;
  --zen-main-browser-background: $dark_background !important;
  --zen-background-opacity: 1 !important;
}

#zen-toolbar-background {
  background-color: $background !important;
  --zen-main-browser-background-toolbar: $background !important;
  --zen-background-opacity: 1 !important;
}

.sidebar-placesTree {
  background-color: $lighter_background !important;
}

#zen-workspaces-button,
#zen-workspace-icons {
  background-color: $background !important;
}

#TabsToolbar {
  background-color: $background !important;
}

#zen-sidebar-top-buttons-customization-target,
#zen-sidebar-splitter {
  background-color: $background !important;
}

#zen-sidebar-splitter {
  opacity: 1 !important;
}

.urlbar-background {
  background-color: $lighter_background !important;
}

.urlbar-input::selection {
  color: $selection_text !important;
  background-color: $selection !important;
}

.urlbarView-url {
  color: $url_color !important;
}

toolbar .toolbarbutton-1 {
  &:not([disabled]) {
    &:is([open], [checked])
      > :is(
        .toolbarbutton-icon,
        .toolbarbutton-text,
        .toolbarbutton-badge-stack
      ) {
      fill: $accent;
    }
  }
}

.identity-color-blue {
  --identity-tab-color: $blue !important;
  --identity-icon-color: $blue !important;
}

.identity-color-turquoise {
  --identity-tab-color: $cyan !important;
  --identity-icon-color: $cyan !important;
}

.identity-color-green {
  --identity-tab-color: $green !important;
  --identity-icon-color: $green !important;
}

.identity-color-yellow {
  --identity-tab-color: $yellow !important;
  --identity-icon-color: $yellow !important;
}

.identity-color-orange {
  --identity-tab-color: $orange !important;
  --identity-icon-color: $orange !important;
}

.identity-color-red {
  --identity-tab-color: $red !important;
  --identity-icon-color: $red !important;
}

.identity-color-pink {
  --identity-tab-color: $identity_pink !important;
  --identity-icon-color: $identity_pink !important;
}

.identity-color-purple {
  --identity-tab-color: $magenta !important;
  --identity-icon-color: $magenta !important;
}

#zen-appcontent-navbar-container {
  background-color: $background !important;
}

#PanelUI-menu-button .toolbarbutton-icon,
#downloads-button .toolbarbutton-icon,
#unified-extensions-button .toolbarbutton-icon {
  fill: $accent !important;
  color: $accent !important;
}

#PanelUI-menu-button .toolbarbutton-badge-stack,
#downloads-button .toolbarbutton-badge-stack,
#unified-extensions-button .toolbarbutton-badge-stack {
  fill: $accent !important;
  color: $accent !important;
}

toolbar .toolbarbutton-1 > .toolbarbutton-icon {
  fill: $accent !important;
}
EOF

if [[ ! -r $output ]] || ! cmp -s "$tmp" "$output"; then
  mv "$tmp" "$output"
fi

content_tmp=$(mktemp "$base/.zen-content-theme.XXXXXX")
cat > "$content_tmp" <<EOF
/* Generated by vellum_shell for Zen Browser's internal new-tab pages. */
@-moz-document url-prefix("about:newtab"), url-prefix("about:home") {
  :root,
  body {
    color-scheme: dark !important;
    color: $foreground !important;
    background-color: $dark_background !important;
    --text-color: $foreground !important;
    --text-color-deemphasized: $muted !important;
    --newtab-background-color: $dark_background !important;
    --newtab-background-color-secondary: $lighter_background !important;
    --newtab-text-primary-color: $foreground !important;
    --newtab-text-secondary-color: $muted !important;
    --newtab-text-secondary-text: $muted !important;
    --newtab-primary-action-background: $accent !important;
    --newtab-element-hover-color: $surface !important;
  }

  input,
  button,
  .fake-textbox {
    color: $foreground !important;
  }

  input::placeholder,
  .fake-textbox {
    opacity: 1 !important;
    color: $muted !important;
  }
}
EOF

if [[ ! -r $content_output ]] || ! cmp -s "$content_tmp" "$content_output"; then
  mv "$content_tmp" "$content_output"
else
  rm -f "$content_tmp"
fi

# Install the generated stylesheet into the active Zen profile. Zen only reads
# userChrome.css when the legacy stylesheet preference is enabled.
zen_root="$HOME/.config/zen"
if [[ -r "$zen_root/installs.ini" ]]; then
  zen_profile=""
  while IFS='=' read -r key value; do
    [[ $key == Default ]] || continue
    zen_profile=$value
    break
  done < "$zen_root/installs.ini"

  profile_dir="$zen_root/$zen_profile"
  if [[ -n $zen_profile && -d $profile_dir ]]; then
    user_js="$profile_dir/user.js"
    set_user_pref() {
      local key=$1 value=$2 pref_tmp pref_found=false
      local pref_prefix="user_pref(\"$key\","
      pref_tmp=$(mktemp "$profile_dir/.vellum-user-js.XXXXXX")
      if [[ -r $user_js ]]; then
        while IFS= read -r line || [[ -n $line ]]; do
          if [[ $line == "$pref_prefix"* ]]; then
            printf 'user_pref("%s", %s);\n' "$key" "$value" >> "$pref_tmp"
            pref_found=true
          else
            printf '%s\n' "$line" >> "$pref_tmp"
          fi
        done < "$user_js"
      fi
      if [[ $pref_found == false ]]; then
        printf 'user_pref("%s", %s);\n' "$key" "$value" >> "$pref_tmp"
      fi
      if [[ ! -r $user_js ]] || ! cmp -s "$pref_tmp" "$user_js"; then
        mv "$pref_tmp" "$user_js"
      else
        rm -f "$pref_tmp"
      fi
    }

    set_user_pref "toolkit.legacyUserProfileCustomizations.stylesheets" true
    set_user_pref "ui.systemUsesDarkTheme" 1
    set_user_pref "browser.theme.toolbar-theme" 0
    set_user_pref "browser.theme.content-theme" 0

    mkdir -p "$profile_dir/chrome"
    user_chrome="$profile_dir/chrome/userChrome.css"
    import='@import url("'"$output"'");'
    import_tmp=$(mktemp "$profile_dir/chrome/.vellum-import.XXXXXX")
    import_found=false
    if [[ -r $user_chrome ]]; then
      while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line == '@import url("'*'/zen-theme.css");' ]]; then
          printf '%s\n' "$import" >> "$import_tmp"
          import_found=true
        else
          printf '%s\n' "$line" >> "$import_tmp"
        fi
      done < "$user_chrome"
    fi
    if [[ $import_found == false ]]; then
      { printf '%s\n\n' "$import"; cat "$import_tmp"; } > "$import_tmp.with-import"
      mv "$import_tmp.with-import" "$import_tmp"
    fi
    if [[ ! -r $user_chrome ]] || ! cmp -s "$import_tmp" "$user_chrome"; then
      mv "$import_tmp" "$user_chrome"
    else
      rm -f "$import_tmp"
    fi

    user_content="$profile_dir/chrome/userContent.css"
    content_import='@import url("'"$content_output"'");'
    content_import_tmp=$(mktemp "$profile_dir/chrome/.vellum-content-import.XXXXXX")
    content_import_found=false
    if [[ -r $user_content ]]; then
      while IFS= read -r line || [[ -n $line ]]; do
        if [[ $line == '@import url("'*'/zen-content-theme.css");' ]]; then
          printf '%s\n' "$content_import" >> "$content_import_tmp"
          content_import_found=true
        else
          printf '%s\n' "$line" >> "$content_import_tmp"
        fi
      done < "$user_content"
    fi
    if [[ $content_import_found == false ]]; then
      { printf '%s\n\n' "$content_import"; cat "$content_import_tmp"; } > "$content_import_tmp.with-import"
      mv "$content_import_tmp.with-import" "$content_import_tmp"
    fi
    if [[ ! -r $user_content ]] || ! cmp -s "$content_import_tmp" "$user_content"; then
      mv "$content_import_tmp" "$user_content"
    else
      rm -f "$content_import_tmp"
    fi
  fi

fi
