  body {
    color-scheme: dark !important;
    color: #f1dfdb !important;
    background-color: #1a1110 !important;
    --text-color: #f1dfdb !important;
    --text-color-deemphasized: #d8c2be !important;
    --newtab-background-color: #1a1110 !important;
    --newtab-background-color-secondary: #322826 !important;
    --newtab-text-primary-color: #f1dfdb !important;
    --newtab-text-secondary-color: #d8c2be !important;
    --newtab-text-secondary-text: #d8c2be !important;
    --newtab-primary-action-background: #ffb4a7 !important;
    --newtab-element-hover-color: #271d1c !important;
  }

  input,
  button,
  .fake-textbox {
    color: #f1dfdb !important;
  }

  input::placeholder,
  .fake-textbox {
    opacity: 1 !important;
    color: #d8c2be !important;
  }
}
