  body {
    color-scheme: dark !important;
    color: #e0def4 !important;
    background-color: #13111b !important;
    --text-color: #e0def4 !important;
    --text-color-deemphasized: #908caa !important;
    --newtab-background-color: #13111b !important;
    --newtab-background-color-secondary: #26233a !important;
    --newtab-text-primary-color: #e0def4 !important;
    --newtab-text-secondary-color: #908caa !important;
    --newtab-text-secondary-text: #908caa !important;
    --newtab-primary-action-background: #ebbcba !important;
    --newtab-element-hover-color: #1f1d2e !important;
  }

  input,
  button,
  .fake-textbox {
    color: #e0def4 !important;
  }

  input::placeholder,
  .fake-textbox {
    opacity: 1 !important;
    color: #908caa !important;
  }
}
