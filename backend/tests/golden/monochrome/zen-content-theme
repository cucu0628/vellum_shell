/* Generated by vellum_shell for Zen Browser's internal new-tab pages. */
@-moz-document url-prefix("about:newtab"), url-prefix("about:home") {
  :root,
  body {
    color-scheme: dark !important;
    color: #e2e2e2 !important;
    background-color: #0d0d0d !important;
    --text-color: #e2e2e2 !important;
    --text-color-deemphasized: #c6c6c6 !important;
    --newtab-background-color: #0d0d0d !important;
    --newtab-background-color-secondary: #1f1f1f !important;
    --newtab-text-primary-color: #e2e2e2 !important;
    --newtab-text-secondary-color: #c6c6c6 !important;
    --newtab-text-secondary-text: #c6c6c6 !important;
    --newtab-primary-action-background: #ffffff !important;
    --newtab-element-hover-color: #1f1f1f !important;
  }

  input,
  button,
  .fake-textbox {
    color: #e2e2e2 !important;
  }

  input::placeholder,
  .fake-textbox {
    opacity: 1 !important;
    color: #c6c6c6 !important;
  }
}
