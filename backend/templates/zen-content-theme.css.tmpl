/* Generated by vellum_shell for Zen Browser's internal new-tab pages. */
@-moz-document url-prefix("about:newtab"), url-prefix("about:home") {
  :root,
  body {
    color-scheme: dark !important;
    color: {{FOREGROUND}} !important;
    background-color: {{DARK_BACKGROUND}} !important;
    --text-color: {{FOREGROUND}} !important;
    --text-color-deemphasized: {{MUTED}} !important;
    --newtab-background-color: {{DARK_BACKGROUND}} !important;
    --newtab-background-color-secondary: {{LIGHTER_BACKGROUND}} !important;
    --newtab-text-primary-color: {{FOREGROUND}} !important;
    --newtab-text-secondary-color: {{MUTED}} !important;
    --newtab-text-secondary-text: {{MUTED}} !important;
    --newtab-primary-action-background: {{ACCENT}} !important;
    --newtab-element-hover-color: {{SURFACE}} !important;
  }

  input,
  button,
  .fake-textbox {
    color: {{FOREGROUND}} !important;
  }

  input::placeholder,
  .fake-textbox {
    opacity: 1 !important;
    color: {{MUTED}} !important;
  }
}
