/* Zen adds compact-mode spacing on both sides of the floating sidebar. Keep
   the outer gutter, but remove the redundant gutter next to web content. */
:root[zen-compact-mode="true"]:not([zen-right-side="true"])
  #navigator-toolbox:not([animate="true"]) {
  padding-right: 0 !important;
}

:root[zen-compact-mode="true"][zen-right-side="true"]
  #navigator-toolbox:not([animate="true"]) {
  padding-left: 0 !important;
}

